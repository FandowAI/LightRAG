# Copy to /etc/fando-lightrag.env; fill credentials on the server, never in Git.
HOST=0.0.0.0
PORT=9621
WORKERS=1
WORKSPACE=enterprise
WORKING_DIR=/data/fando/lightrag/rag_storage
INPUT_DIR=/data/fando/lightrag/inputs
LOG_DIR=/data/fando/lightrag/logs
LIGHTRAG_BATCH_OUTPUT_DIR=/data/fando/lightrag/exports
LIGHTRAG_BATCH_MAX_GRAPH_NODES=10000
LIGHTRAG_BATCH_MAX_GRAPH_RELATIONS=20000
# At most two rare near-duplicate confirmations per batch; zero disables them.
LIGHTRAG_DEDUP_MAX_LLM_CHECKS=2
PROMPT_DIR=/opt/fando/lightrag/prompts
ENTITY_TYPE_PROMPT_FILE=fando_enterprise.yml
ENTITY_EXTRACTION_USE_JSON=true
ENTERPRISE_KNOWLEDGE_ENABLED=true
SUMMARY_LANGUAGE=Chinese
WEBUI_TITLE=FanDo

# Production storage services; provision/retain their persistent volumes separately.
LIGHTRAG_KV_STORAGE=RedisKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
REDIS_URI=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=lightrag
MILVUS_TOKEN=REPLACE_MILVUS_TOKEN

# Use server-reachable model APIs. A Windows SSH tunnel is never required here.
LLM_BINDING=openai
LLM_BINDING_HOST=https://REPLACE_MODEL_API/v1
LLM_BINDING_API_KEY=REPLACE_LLM_API_KEY
LLM_MODEL=REPLACE_MODEL_NAME
MAX_ASYNC_LLM=4
EXTRACT_MAX_ASYNC_LLM=4
MAX_PARALLEL_INSERT=2
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:9622/v1
EMBEDDING_BINDING_API_KEY=REPLACE_EMBEDDING_API_KEY
EMBEDDING_MODEL=Qwen3-VL-Embedding-8B
EMBEDDING_DIM=4096
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_BATCH_NUM=8

# Require authentication before exposing the service to the company network.
LIGHTRAG_API_KEY=REPLACE_WITH_RANDOM_API_KEY
AUTH_ACCOUNTS=admin:REPLACE_ADMIN_PASSWORD
TOKEN_SECRET=REPLACE_WITH_RANDOM_TOKEN_SECRET
WHITELIST_PATHS=/health

# Optional private reviewed roster. Leave unset until one is installed.
# ENTITY_IDENTITY_REGISTRY_FILE=/etc/fando/enterprise-roster.private.json

# Distillation uses the local workflow integration configuration.
# LIGHTRAG_DATA_WORKFLOW_CONFIG=/absolute/path/to/data_workflow.yaml
